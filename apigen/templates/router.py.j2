"""Endpoints de `{{ plural }}` ({{ version }}), generados por apigen: edítalos libremente.

Permisos: list={{ perm.list }}, read={{ perm.read }}, create={{ perm.create }}, update={{ perm.update }}, delete={{ perm.delete }}
{% if spec.owned %}
Recurso con propietario: con nivel `owner` cada usuario solo ve/modifica sus
filas (las ajenas devuelven 404, sin revelar que existen); un admin ve todas.
{% endif %}
"""

import uuid
from typing import Annotated, {{ "Any, " if has_sync else "" }}Literal
{{ router_imports }}

from fastapi import APIRouter, Depends, HTTPException, Query, Request, Response, status

import app.hooks.{{ name }} as hooks
from app.api.deps import (
    PaginationDep,
    Principal,
    SessionDep,
    error_responses,
    query_guard,
    require,
)
{% if has_background %}
from app.core.config import settings
{% endif %}
from app.core.permissions import Access, Scope
{% if rate_read or rate_write or action_rates %}
from app.core.rate_limit import limiter
{% endif %}
from app.crud.base import Repository{% if references %}, ensure_reference{% endif %}

from app.hooks import HookContext

{% for ref in references %}
from app.models.{{ ref.module }} import {{ ref.model }}
{% endfor %}
from app.models.{{ name }} import {{ cls }}{% for e in enums.values() %}, {{ e.cls }}{% endfor %}

from app.schemas.common import Page
from app.schemas.{{ name }} import {{ cls }}Create, {{ cls }}Read, {{ cls }}Update{% for a in actions if a.input_cls %}, {{ a.input_cls }}{% endfor %}

{% if has_background %}
from app.tasks.queue import JobAccepted, enqueue
{% endif %}

router = APIRouter(
    prefix="/{{ plural }}", tags=[{{ plural | py }}], responses=error_responses(401, 403, 429)
)

repo = Repository(
    {{ cls }},
    owner_field={{ "\"owner_id\"" if spec.owned else "None" }},
    soft_delete={{ spec.soft_delete }},
    search_fields=({% for f in search_fields %}{{ f | py }}, {% endfor %}),
    ordering_fields=({% for f in ordering %}{{ f | py }}, {% endfor %}),
)

CanList = Annotated[Principal, Depends(require(Access.{{ perm.list }}, Scope.read))]
CanRead = Annotated[Principal, Depends(require(Access.{{ perm.read }}, Scope.read))]
CanCreate = Annotated[Principal, Depends(require(Access.{{ perm.create }}, Scope.write))]
CanUpdate = Annotated[Principal, Depends(require(Access.{{ perm.update }}, Scope.write))]
CanDelete = Annotated[Principal, Depends(require(Access.{{ perm.delete }}, Scope.write))]
{% for a in actions %}
{{ a.alias }} = Annotated[Principal, Depends(require(Access.{{ a.perm }}, Scope.write))]
{% endfor %}

OrderBy = Literal[{% for v in order_values %}{{ v | py }}{{ ", " if not loop.last }}{% endfor %}]


async def _get_or_404(
    session: SessionDep, item_id: uuid.UUID, principal: Principal, *, scoped: bool
) -> {{ cls }}:
    owner_id = principal.owner_filter() if scoped else None
    obj = await repo.get(session, item_id, owner_id=owner_id)
    if obj is None:
        raise HTTPException(status.HTTP_404_NOT_FOUND, detail="{{ cls }} not found")
    return obj
{% if references %}


async def _check_references(
    session: SessionDep, principal: Principal, data: {{ cls }}Create | {{ cls }}Update
) -> None:
    """Impide referenciar filas que el usuario no puede ver (IDOR vía clave foránea)."""
    sent = data.model_fields_set
{% for ref in references %}
    if "{{ ref.field }}" in sent and data.{{ ref.field }} is not None:
        await ensure_reference(
            session,
            {{ ref.model }},
            data.{{ ref.field }},
            owner_id={{ "principal.owner_filter()" if ref.scoped else "None" }},
            soft_delete={{ ref.soft_delete }},
            field="{{ ref.field }}",
{% if ref.module == "user" %}
            # Cualquier usuario existente: si el campo representa "el dueño", usa
            # `owned: true` (owner_id lo fija el servidor) o limita aquí a principal.user_id.
{% endif %}
{% if ref.admin_only %}
            # Solo un admin puede leer {{ ref.module }}: solo un admin puede referenciarlo.
            allowed=principal.is_admin,
{% endif %}
        )
{% endfor %}
{% endif %}


@router.get(
    "",
    response_model=Page[{{ cls }}Read],
    description=(
{% for chunk in list_description %}
        {{ chunk }}
{% endfor %}
    ),
    dependencies=[
        Depends(
            query_guard(
                frozenset({{ '{' }}{% for q in query_allowed %}{{ q | py }}{{ ", " if not loop.last }}{% endfor %}{{ '}' }}),
                frozenset({{ '{' }}{% for q in query_fields %}{{ q | py }}{{ ", " if not loop.last }}{% endfor %}{{ '}' }}),
            )
        )
    ],
)
{% if rate_read %}
@limiter.limit({{ rate_read | py }})
{% endif %}
async def list_{{ plural }}(
{% if rate_read %}
    request: Request,
    response: Response,
{% endif %}
    principal: CanList,
    session: SessionDep,
    page: PaginationDep,
{% if search_fields %}
    q: Annotated[str | None, Query(max_length=100, description="Búsqueda de texto")] = None,
{% endif %}
    order_by: OrderBy = "-created_at",
{% for f in filters %}
    {{ f }},
{% endfor %}
) -> Page[{{ cls }}Read]:
    items, total = await repo.list(
        session,
        offset=page.offset,
        limit=page.limit,
        filters={ {% for f in filter_names %}{{ f | py }}: {{ f }}{{ ", " if not loop.last }}{% endfor %} },
        search={{ "q" if search_fields else "None" }},
        order_by=order_by,
        owner_id={{ "principal.owner_filter()" if perm.list == "owner" else "None" }},
    )
    return Page(items=items, total=total, limit=page.limit, offset=page.offset)  # type: ignore[arg-type]


@router.post(
    "",
    response_model={{ cls }}Read,
    status_code=status.HTTP_201_CREATED,
{% if spec.description %}
    description=(
{% for chunk in description_chunks %}
        {{ chunk }}
{% endfor %}
    ),
{% endif %}
    responses=error_responses(409),
)
{% if rate_write %}
@limiter.limit({{ rate_write | py }})
{% endif %}
async def create_{{ name }}(
{% if rate_write %}
    request: Request,
    response: Response,
{% endif %}
    payload: {{ cls }}Create,
    principal: CanCreate,
    session: SessionDep,
) -> {{ cls }}:
    # Lógica propia: app/hooks/{{ name }}.py (apigen nunca sobrescribe ese fichero).
    ctx = HookContext(session=session, principal=principal)
    payload = await hooks.before_create(ctx, payload)
{% if references %}
    await _check_references(session, principal, payload)
{% endif %}
{% if spec.owned %}
    obj = await repo.create(session, payload, owner_id=principal.user_id)
{% else %}
    obj = await repo.create(session, payload)
{% endif %}
    await hooks.after_create(ctx, obj)
    return obj


@router.get("/{item_id}", response_model={{ cls }}Read, responses=error_responses(404))
{% if rate_read %}
@limiter.limit({{ rate_read | py }})
{% endif %}
async def get_{{ name }}(
{% if rate_read %}
    request: Request,
    response: Response,
{% endif %}
    item_id: uuid.UUID,
    principal: CanRead,
    session: SessionDep,
) -> {{ cls }}:
    return await _get_or_404(session, item_id, principal, scoped={{ perm.read == "owner" }})


@router.patch("/{item_id}", response_model={{ cls }}Read, responses=error_responses(404, 409))
{% if rate_write %}
@limiter.limit({{ rate_write | py }})
{% endif %}
async def update_{{ name }}(
{% if rate_write %}
    request: Request,
    response: Response,
{% endif %}
    item_id: uuid.UUID,
    payload: {{ cls }}Update,
    principal: CanUpdate,
    session: SessionDep,
) -> {{ cls }}:
    obj = await _get_or_404(session, item_id, principal, scoped={{ perm.update == "owner" }})
    ctx = HookContext(session=session, principal=principal)
    payload = await hooks.before_update(ctx, obj, payload)
{% if references %}
    await _check_references(session, principal, payload)
{% endif %}
    obj = await repo.update(session, obj, payload)
    await hooks.after_update(ctx, obj)
    return obj


@router.delete(
    "/{item_id}", status_code=status.HTTP_204_NO_CONTENT, responses=error_responses(404, 409)
)
{% if rate_write %}
@limiter.limit({{ rate_write | py }})
{% endif %}
async def delete_{{ name }}(
{% if rate_write %}
    request: Request,
    response: Response,
{% endif %}
    item_id: uuid.UUID,
    principal: CanDelete,
    session: SessionDep,
) -> None:
    obj = await _get_or_404(session, item_id, principal, scoped={{ perm.delete == "owner" }})
    ctx = HookContext(session=session, principal=principal)
    await hooks.before_delete(ctx, obj)
    await repo.delete(session, obj)
    await hooks.after_delete(ctx, obj)
{% for a in actions %}


@router.post(
    "{{ a.path }}",
{% if a.background %}
    response_model=JobAccepted,
    status_code=status.HTTP_202_ACCEPTED,
{% endif %}
    description=(
{% for chunk in a.description %}
        {{ chunk }}
{% endfor %}
    ),
    responses=error_responses({{ "404" if a.scope == "item" else "" }}),
)
{% if a.rate %}
@limiter.limit({{ a.rate | py }})
{% endif %}
async def {{ a.func }}(
{% if a.rate %}
    request: Request,
{% endif %}
{% if a.background or a.rate %}
    response: Response,
{% endif %}
{% if a.scope == "item" %}
    item_id: uuid.UUID,
{% endif %}
    principal: {{ a.alias }},
    session: SessionDep,
{% if a.input_cls %}
    payload: {{ a.input_cls }},
{% endif %}
) -> {{ "JobAccepted" if a.background else "dict[str, Any]" }}:
{% if a.scope == "item" %}
    obj = await _get_or_404(session, item_id, principal, scoped={{ a.scoped }})
{% endif %}
{% if a.background %}
    # Solo se encola (una inserción): el trabajo lo ejecuta `apigen worker` aparte.
    job = await enqueue(
        session,
        "{{ a.task }}",
        {
{% if a.scope == "item" %}
            "item_id": str(obj.id),
{% endif %}
{% if a.input_cls %}
            **payload.model_dump(mode="json"),
{% endif %}
        },
        owner_id=principal.user_id,
    )
    status_url = f"{settings.API_PREFIX}/{{ version }}/jobs/{job.id}"
    response.headers["Location"] = status_url
    return JobAccepted(job_id=job.id, status=job.status, status_url=status_url)
{% else %}
    ctx = HookContext(session=session, principal=principal)
    return await hooks.{{ a.name }}(
        ctx,
{% if a.scope == "item" %}
        obj,
{% endif %}
        {{ "payload.model_dump(mode=\"json\")" if a.input_cls else "{}" }},
    )
{% endif %}
{% endfor %}
