async def _payload(db, owner_id: uuid.UUID) -> dict:
    """Payload válido. Crea antes las filas padre que exigen las claves foráneas."""
{% for s in test.setup %}
    {{ s.var }} = {{ s.cls }}({% for k, v in s.attrs.items() %}{{ k }}={{ v }}{{ ", " if not loop.last }}{% endfor %})
