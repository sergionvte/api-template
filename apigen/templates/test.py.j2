async def test_action_{{ a.name }}(
    client, db, user, user_headers, admin, admin_headers{{ ", other_headers" if a.scope == "item" and a.scoped else "" }}
):
{% if a.scope == "item" %}
    payload = await _payload(db, {{ creator }}.id)
    created = await client.post(BASE, json=payload, headers={{ headers(perm.create) }})
    assert created.status_code == 201, created.text
    url = f"{BASE}/{created.json()['id']}/{{ a.name }}"
{% else %}
    url = f"{BASE}/{{ a.name }}"
{% endif %}
    body = { {% for k, v in a.test_payload.items() %}{{ k | py }}: {{ v }}, {% endfor %} }
    # Campos desconocidos en el cuerpo: 422, como en el resto de la API.
    extra = await client.post(url, json={**body, "unexpected": 1}, headers={{ headers(a.perm) }})
    assert extra.status_code == 422, extra.text
{% if a.scope == "item" and a.scoped %}
    # Solo el dueño (o un admin): para otro usuario la fila no existe.
    other = await client.post(url, json=body, headers=other_headers)
    assert other.status_code == 404, other.text
{% endif %}
    response = await client.post(url, json=body, headers={{ headers(a.perm) }})
{% if a.background %}
    # La API solo encola (202); el trabajo lo ejecuta el worker.
    assert response.status_code == 202, response.text
    job = response.json()
    assert response.headers["location"] == job["status_url"]
    await process_pending()
    done = await client.get(job["status_url"], headers={{ headers(a.perm) }})
    assert done.status_code == 200, done.text
    assert done.json()["status"] == "succeeded", done.json()
{% else %}
    assert response.status_code == 200, response.text
{% endif %}
{% if a.perm != "public" %}
    assert (await client.post(url, json=body)).status_code == 401
{% endif %}
{% endfor %}
