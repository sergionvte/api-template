async def test_crud_flow(client, db, user, user_headers, admin, admin_headers):
    payload = await _payload(db, {{ creator }}.id)
    created = await client.post(BASE, json=payload, headers={{ headers(perm.create) }})
    assert created.status_code == 201, created.text
    body = created.json()
    item_id = body["id"]
{% for f in test.write_only %}
    assert {{ f | py }} not in body
{% endfor %}
{% if spec.owned %}
    assert body["owner_id"] == str({{ creator }}.id)
{% endif %}

    got = await client.get(f"{BASE}/{item_id}", headers={{ headers(perm.read) }})
    assert got.status_code == 200, got.text

    listed = await client.get(BASE, params={"limit": 100}, headers={{ headers(perm.list) }})
    assert listed.status_code == 200, listed.text
    assert item_id in [row["id"] for row in listed.json()["items"]]

{% if test.update_field %}
    new_value = {{ test.update_field[1] }}
    updated = await client.patch(
        f"{BASE}/{item_id}", json={ {{ test.update_field[0] | py }}: new_value}, headers={{ headers(perm.update) }}
    )
    assert updated.status_code == 200, updated.text
    assert updated.json()[{{ test.update_field[0] | py }}] == new_value
{% else %}
    updated = await client.patch(f"{BASE}/{item_id}", json={}, headers={{ headers(perm.update) }})
    assert updated.status_code == 200, updated.text
{% endif %}

    deleted = await client.delete(f"{BASE}/{item_id}", headers={{ headers(perm.delete) }})
    assert deleted.status_code == 204, deleted.text
    gone = await client.get(f"{BASE}/{item_id}", headers={{ headers(perm.read) }})
    assert gone.status_code == 404


async def test_rejects_unknown_fields(client, db, user, user_headers, admin, admin_headers):
    """Asignación masiva: no se pueden colar campos como id u owner_id."""
    payload = await _payload(db, {{ creator }}.id)
    payload.update({"id": str(uuid.uuid4()), "owner_id": str(uuid.uuid4()), "is_admin": True})
    response = await client.post(BASE, json=payload, headers={{ headers(perm.create) }})
    assert response.status_code == 422


