async def test_unique_{{ test.unique_field }}(client, db, user, user_headers, admin, admin_headers):
    payload = await _payload(db, {{ creator }}.id)
    first = await client.post(BASE, json=payload, headers={{ headers(perm.create) }})
    assert first.status_code == 201, first.text
    second = await client.post(BASE, json=payload, headers={{ headers(perm.create) }})
    assert second.status_code == 409
    assert second.json()["code"] == "unique_violation"
    # Con varios campos únicos, la BD informa del primero que falla.
    assert set(second.json()["fields"]) <= {{ '{' }}{% for n in test.unique_fields %}{{ n | py }}{{ ", " if not loop.last }}{% endfor %}{{ '}' }}
{% if spec.soft_delete %}
    # Con soft delete, un valor borrado se puede volver a usar (índice único parcial).
    deleted = await client.delete(f"{BASE}/{first.json()['id']}", headers={{ headers(perm.delete) }})
    assert deleted.status_code == 204
    again = await client.post(BASE, json=payload, headers={{ headers(perm.create) }})
    assert again.status_code == 201, again.text
{% endif %}
{% endif %}
