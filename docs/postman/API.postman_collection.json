{
  "info": {
    "_postman_id": "852cbd02-9823-48b6-94dc-d0ea5b796dc7",
    "name": "API (FastAPI + JWT)",
    "description": "Colección base para las APIs creadas con la plantilla.\n\n1. Ajusta las variables de la colección `baseUrl`, `apiPrefix`, `email` y `password` (usa **Current value**, no se sincroniza).\n2. Ejecuta **Auth > Login**: los tokens se guardan solos.\n3. El resto de peticiones heredan `Bearer {{accessToken}}` y el token se renueva automáticamente antes de caducar.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Renovación automática: si el access token caduca en menos de 30 s y hay refresh token,",
          "// se pide un par nuevo antes de enviar la petición (excepto en /auth/ y /health/).",
          "const url = pm.request.url.toString();",
          "const exp = Number(pm.collectionVariables.get(\"accessTokenExpiresAt\") || 0);",
          "const refresh = pm.collectionVariables.get(\"refreshToken\");",
          "if (!url.includes(\"/auth/\") && !url.includes(\"/health/\") && refresh && Date.now() > exp - 30000) {",
          "  pm.sendRequest({",
          "    url: pm.variables.get(\"baseUrl\") + pm.variables.get(\"apiPrefix\") + \"/auth/refresh\",",
          "    method: \"POST\",",
          "    header: { \"Content-Type\": \"application/json\" },",
          "    body: { mode: \"raw\", raw: JSON.stringify({ refresh_token: refresh }) }",
          "  }, (err, res) => {",
          "    if (!err && res.code === 200) {",
          "      const d = res.json();",
          "      pm.collectionVariables.set(\"accessToken\", d.access_token);",
          "      pm.collectionVariables.set(\"refreshToken\", d.refresh_token);",
          "      pm.collectionVariables.set(\"accessTokenExpiresAt\", String(Date.now() + d.expires_in * 1000));",
          "      console.log(\"Token renovado automáticamente\");",
          "    } else {",
          "      console.warn(\"Refresh automático falló: vuelve a ejecutar Auth > Login\", err || (res && res.code));",
          "    }",
          "  });",
          "}"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "apiPrefix",
      "value": "/api/v1"
    },
    {
      "key": "email",
      "value": "usuario@example.com"
    },
    {
      "key": "password",
      "value": "",
      "type": "secret"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "secret"
    },
    {
      "key": "refreshToken",
      "value": "",
      "type": "secret"
    },
    {
      "key": "accessTokenExpiresAt",
      "value": "0"
    },
    {
      "key": "jobId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}{{apiPrefix}}/auth/register",
              "host": [
                "{{baseUrl}}{{apiPrefix}}/auth/register"
              ]
            },
            "description": "Crea una cuenta (JSON). Contraseña: 12+ caracteres, sin contener tu email.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"full_name\": \"Nombre Apellido\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 201\", () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}{{apiPrefix}}/auth/login",
              "host": [
                "{{baseUrl}}{{apiPrefix}}/auth/login"
              ]
            },
            "description": "OAuth2 password flow: **x-www-form-urlencoded** (no JSON). Guarda access y refresh token.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "username",
                  "value": "{{email}}",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "{{password}}",
                  "type": "text"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Guarda los tokens en variables de la colección para las siguientes peticiones.",
                  "if (pm.response.code === 200) {",
                  "  const d = pm.response.json();",
                  "  pm.collectionVariables.set(\"accessToken\", d.access_token);",
                  "  pm.collectionVariables.set(\"refreshToken\", d.refresh_token);",
                  "  pm.collectionVariables.set(\"accessTokenExpiresAt\", String(Date.now() + d.expires_in * 1000));",
                  "}",
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}{{apiPrefix}}/users/me",
              "host": [
                "{{baseUrl}}{{apiPrefix}}/users/me"
              ]
            },
            "description": "Comprueba que el token funciona."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
