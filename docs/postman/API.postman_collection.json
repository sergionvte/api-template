            "description": "Revoca el refresh token (cierra esta sesión). El access token vigente sigue valiendo hasta su caducidad (máx. 15 min).",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refreshToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('refreshToken', '');",
                  "pm.test(\"status 204\", () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout de todas las sesiones",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}{{apiPrefix}}/auth/logout-all",
              "host": [
                "{{baseUrl}}{{apiPrefix}}/auth/logout-all"
              ]
            },
            "description": "Invalida al instante TODOS los tokens del usuario (útil si se sospecha robo)."
