        },
        {
          "name": "Refresh",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}{{apiPrefix}}/auth/refresh",
              "host": [
                "{{baseUrl}}{{apiPrefix}}/auth/refresh"
              ]
            },
            "description": "Rota el refresh token: el anterior deja de valer. 409 `refresh_token_rotated` = otra pestaña ya lo renovó.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refreshToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Guarda los tokens en variables de la colección para las siguientes peticiones.",
                  "if (pm.response.code === 200) {",
                  "  const d = pm.response.json();",
                  "  pm.collectionVariables.set(\"accessToken\", d.access_token);",
                  "  pm.collectionVariables.set(\"refreshToken\", d.refresh_token);",
                  "  pm.collectionVariables.set(\"accessTokenExpiresAt\", String(Date.now() + d.expires_in * 1000));",
                  "}",
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
